{
	"name": "einbuergerungstest-api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.6.0",
		"pnpm": ">=11.8.0"
	},
	"scripts": {
		"serve": "tsx watch src/server.ts",
		"build": "tsc && pnpm exec tsc-alias && cp -R src/db/migrations dist/api/src/db/",
		"db:migrate": "tsx src/db/migrate.ts",
		"db:reset": "tsx src/db/reset.ts",
		"extract:schema": "node scripts/extract-schema.mjs",
		"start": "node dist/api/src/server.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --coverage",
		"test:watch": "vitest watch",
		"quick": "vitest run",
		"test:real": "vitest run --config vitest.real.config.ts",
		"lint": "eslint src test --no-fix && pnpm lint:shared",
		"lint:shared": "cd ../shared && eslint -c ../api/eslint.config.mjs --no-fix .",
		"linter": "eslint src test --no-fix --quiet",
		"lint:fix": "eslint src test --fix && cd ../shared && eslint -c ../api/eslint.config.mjs --fix .",
		"imports": "eslint src test --no-fix --rule unused-imports/no-unused-imports:error",
		"fiximports": "eslint src test --fix --rule unused-imports/no-unused-imports:error",
		"format": "prettier --log-level silent --write \"src/**/*.{js,json,ts}\" \"test/**/*.{js,ts}\" \"../shared/**/*.ts\"",
		"format_check": "prettier --check \"src/**/*.{js,json,ts}\" \"test/**/*.{js,ts}\" \"../shared/**/*.ts\"",
		"ft": "pnpm format && pnpm test",
		"bl": "pnpm build && pnpm lint:fix",
		"fix": "pnpm i && pnpm dedupe && pnpm audit --fix=override && skeletest -f && pnpm format && git add test && pnpm lint:fix",
		"magic": "pnpm fix",
		"up": "pnpm up -i",
		"l": "pnpm up -i -L",
		"dupe": "pnpm dedupe --check && pnpm audit",
		"check": "pnpm i && pnpm format_check && pnpm lint && pnpm typecheck && skeletest && pnpm build && pnpm test"
	},
	"dependencies": {
		"@fastify/cors": "^11.3.1",
		"@fastify/jwt": "^10.2.5",
		"@fastify/oauth2": "^8.3.2",
		"@fastify/rate-limit": "^11.2.1",
		"@mikro-orm/core": "^7.2.5",
		"@mikro-orm/postgresql": "^7.2.5",
		"dotenv": "^18.0.9",
		"fastify": "^5.2.2",
		"pg": "^8.23.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@dbml/cli": "10.3.1",
		"@electric-sql/pglite": "^0.5.11",
		"@eslint/js": "^10.0.1",
		"@mikro-orm/pglite": "7.2.5",
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-sonarjs": "^4.2.2",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.13.0",
		"prettier": "^3.8.4",
		"skeletest": "^0.7.5",
		"tsc-alias": "^1.9.9",
		"tsx": "^4.19.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@12.8.2"
}
