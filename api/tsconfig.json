{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2024"],
		"outDir": "./dist",
		"rootDir": "..",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"paths": {
			"@/*": ["./src/*"],
			"#shared/*": ["../shared/*"],
		},
	},
	"include": ["src/**/*", "../shared/**/*.ts"],
	"exclude": ["node_modules", "dist", "test", "../shared/test"],
	"tsc-alias": {
		"resolveFullPaths": true,
	},
}
