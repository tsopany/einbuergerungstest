{
	"name": "@einbuergerungstest/client",
	"private": true,
	"version": "0.0.1",
	"engines": {
		"node": ">=24.6.0",
		"pnpm": ">=11.8.0"
	},
	"description": "Einbürgerungstest Frontend Vue Application",
	"type": "module",
	"author": "Tsopany",
	"license": "MIT",
	"scripts": {
		"serve": "infisical run --env=dev --recursive -- vite serve --port 3051 --open",
		"build": "vue-tsc && vite build",
		"typecheck": "vue-tsc --noEmit",
		"quick": "vitest run",
		"test": "vitest run --coverage",
		"test:watch": "vitest watch",
		"bail": "vitest run --coverage --bail 1",
		"lint": "eslint src test --no-fix",
		"linter": "eslint src test --no-fix --quiet",
		"lint:fix": "eslint src test --fix",
		"imports": "eslint src test --no-fix --rule unused-imports/no-unused-imports:error",
		"fiximports": "eslint src test --fix --rule unused-imports/no-unused-imports:error",
		"format": "prettier --log-level error --write \"src/**/*.{vue,js,json,ts}\" \"test/**/*.{js,ts}\"",
		"format_check": "prettier --check \"src/**/*.{vue,js,json,ts}\" \"test/**/*.{js,ts}\"",
		"ft": "pnpm format && pnpm test",
		"bl": "pnpm build && pnpm lint:fix",
		"fix": "pnpm i && pnpm dedupe && skeletest -f && pnpm format && git add test && pnpm lint:fix",
		"magic": "pnpm fix",
		"up": "pnpm up -i",
		"l": "pnpm up -i -L",
		"dupe": "pnpm dedupe --check && pnpm audit",
		"check": "pnpm i && skeletest && pnpm format_check && pnpm lint && pnpm typecheck && pnpm build && pnpm test"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"pinia": "^4.0.3",
		"vite": "^8.3.5",
		"vue": "^3.5.43",
		"vue-i18n": "^11.4.16",
		"vue-router": "^5.4.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.4",
		"@typescript-eslint/eslint-plugin": "^8.72.0",
		"@typescript-eslint/parser": "^8.72.0",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vitest/coverage-v8": "^5.0.5",
		"@vue/test-utils": "^2.5.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-sonarjs": "^4.2.2",
		"eslint-plugin-unused-imports": "^4.4.1",
		"eslint-plugin-vue": "^10.11.1",
		"globals": "^17.13.0",
		"happy-dom": "^21.0.4",
		"prettier": "^3.9.9",
		"skeletest": "^0.7.5",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5",
		"vue-eslint-parser": "^10.4.1",
		"vue-tsc": "^3.3.12"
	},
	"packageManager": "pnpm@12.8.2"
}
